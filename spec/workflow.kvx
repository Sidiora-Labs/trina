# Trina spec workflow: the single workflow source for this repository.
# CLAUDE.md and AGENTS.md only point here (hyperfide spec render).

[meta]
name            = "Trina Workflow"
active_feature  = "trina-memory"
source_of_truth = "spec/ (kvx). Generated files are pointers — regenerate, never hand-edit."

[mode]
name = "parallel"

[limits]
max_in_progress = 4

[agents]
driver = "claude"
max    = 6
ttl    = 3600

# The fleet: the main agent owns the task list, supervises and merges, and
# does not implement tasks. A wave manager owns one wave branch; a task
# worker owns one task on a branch cut from its wave branch. Work merges
# upward: task into wave, wave into main behind the test and lint gates.
[hierarchy]
enabled    = true
main       = "main"
remote     = "origin"
worktrees  = ".codegraph/worktrees"
test_gate  = "make test"
lint_gate  = "make lint"
pr         = "off"
# The main supervisor pushes main to origin after each wave lands; workers never push.
checkpoint = "manual"
sparse     = "slice"
waves      = "sequential"

[role.main]
title  = "Main Supervisor"
agent  = "gideon"
branch = "{main}"

[role.manager]
title  = "Wave Manager"
agent  = "wm-{feature}-{wave}"
branch = "wave/{feature}/{wave}"
base   = "{main}"

[role.worker]
title  = "Task Worker"
agent  = "w-{feature}-{task}"
branch = "task/{feature}/{task}"
base   = "wave/{feature}/{wave}"

[principle]
task_driven     = "Work is driven by the active feature's task list, in wave order, one claimed task per worker."
supervision     = "The main agent plans, assigns, reviews and merges. It does not implement task work; implementation belongs to task workers."
verified_done   = "A task is done only when hyperfide spec done reruns its verify_cmd and it passes. A test that could not reach an external dependency reports SKIPPED and is never a pass. A component passing never certifies a full case."
dependencies    = "Python dependencies are declared in pyproject.toml and pinned in uv.lock. Adding one outside a task's stated scope needs a decision Ask first."
data_boundary   = "Raw bucket objects are never copied into the repository or left on persistent disk. Only redacted, derived records are persisted. The bucket source prefixes are read-only."
secrets         = "Credentials live only in the ignored files .env and .ssh.creds. They never appear in tracked files, logs, run records, command lines or messages."
commits         = "A commit subject is short and plain: an imperative summary under 60 characters, then the task tag. No body unless it records a decision. No narration of process, no account of what went wrong, no apologies, jokes or attribution lines."
evidence        = "The main supervisor records each wave's qualification evidence in the feature qualification.kvx when the wave lands; workers do not edit it."
operator        = "Operator-supplied values (teacher prices, rate limits, the spend cap for live tests) are in configs/operator.toml, also named by TRINA_OPERATOR_LAYER. Use it as the last configuration layer for live tests; do not raise an Ask for these."
spend           = "Teacher calls go through the teacher client with its budget cap. No agent calls a model provider for project data outside it."

[loop]
step_1 = "hyperfide brief — load repo state, the active task and prior decisions."
step_2 = "hyperfide spec next — take the lowest-wave eligible task."
step_3 = "hyperfide spec start <id> — claim it in an isolated task worktree."
step_4 = "Read the task in spec/trina-memory/spec.kvx, the contract documents its requirements name, and hyperfide context <area> for the code."
step_5 = "Implement only the claimed task, inside its touches. Never default what you were not given: raise an Ask and keep working on what does not depend on it."
step_6 = "hyperfide review against the task's criteria; hyperfide guard for scope."
step_7 = "Update the task status in the feature spec.kvx, then commit explicit paths with a message tagged [spec:<feature>/<id>]."
step_8 = "hyperfide spec done <id> — qualification reruns verify_cmd; done means proven."

[memory]
recall   = "hyperfide recall at session start; hyperfide brief includes it."
remember = "hyperfide remember decisions and constraints as they occur, not afterwards."

[status_values]
task = ["pending", "in_progress", "blocked", "implemented", "done", "superseded"]

[human]
job_1 = "Create the idea and the feature spec together with an agent."
job_2 = "Provide variables, secrets and permissions, and judge output by answering Asks."
job_3 = "Test the finished running system; that test is the release gate and closes the feature."

[asks]
kinds = ["secret", "variable", "permission", "decision", "question"]
secret     = "block"
variable   = "block"
permission = "block"
decision   = "proceed-and-flag"
question   = "proceed-and-flag"

[publication]
cadence    = "Per wave: qualified task results merge together once the wave closes."
final_wave = "The last wave is documentation and release closure."
task_file  = "The feature spec.kvx task statuses are current before every commit."

[hard_rules]
no_fakes          = "Never fake or weaken a test to make it pass."
no_false_done     = "Never mark a task done that did not qualify."
no_silent_default = "Never default a secret, variable, permission or decision you were not given; raise an Ask."
no_raw_data       = "Never commit bucket data, datasets, checkpoints or credentials."

[render]
markdown_mirror = false
mirror_to_kiro  = false
banner = "GENERATED by hyperfide spec render from spec/ kvx — DO NOT EDIT."

[adapters]
claude = "CLAUDE.md"
agents = "AGENTS.md"
