# Trina qualification log.
#
# All 28 qualification cases, TRM-001 to TRM-028, are UNRUN. No product code exists and
# no product test has been executed. This file records no result for any case.
#
# The [observation.*] entries below are authoring-time observations of the starting
# environment, copied from baseline.md. They are not product evidence and satisfy no
# acceptance clause. Commands are described in words; exit codes and logs were not
# retained at authoring time, so those fields are absent rather than invented.
#
# Product evidence is appended by scripts/record_evidence.py (task 0.1), which the main
# supervisor runs when a wave lands; task workers do not edit this file, and release
# closure (task 7.2) collects the final reports into it. Each entry is one execution with
# revision, command, exit_code, log and observed (clause 15.2). A case is never marked
# as succeeded without a log, and a test that could not reach an external dependency
# is recorded as SKIPPED (clause 15.1).

[summary]
feature = "trina-memory"
recorded = "2026-11-10"
requirements = 15
acceptance_clauses = 72
tasks = 30
cases_total = 28
cases_unrun = 28
cases_with_evidence = 0
source = "spec/trina-memory/baseline.md"

[observation.workspace]
revision = "none (no commits at authoring time)"
command = "Inspected the project root, its git state and the Hyperfide state."
observed = "Git is initialised on main with no commits and no remote. Hyperfide 2.0.0-dev has an initialised code graph and the active feature is trina-memory."
assumption = "No source baseline exists, so every task starts from an empty tree. Pull requests stay off until a remote is configured."

[observation.build_host]
revision = "none (no commits at authoring time)"
command = "Queried CPU count, memory, free disk, GPU presence, the Python version and the presence of uv, the agent drivers and gh on the build host."
observed = "64 CPUs, 251 GB RAM, 499 GB free disk, no GPU, Python 3.12.3, uv absent. Agent drivers claude and codex are present; gh is present."
assumption = "Task 0.1 must install uv. The build host can run only the CPU smoke configuration; no timing of that configuration has been measured."

[observation.credential_files]
revision = "none (no commits at authoring time)"
command = "Checked the mode and ignore status of the two credential files without reading their contents."
observed = "Both files are mode 600 and ignored by git. The environment file is ignored by Hyperfide."
assumption = "The hygiene gate of task 0.1 re-checks both conditions for both files on every lint run; this observation does not qualify clause 3.5."

[observation.bucket_listing]
revision = "none (no commits at authoring time)"
command = "Listed the source bucket read-only with s5cmd and summed objects and bytes by top-level prefix."
observed = "642,028 objects and 171.8 GB. 9router/calls/: 167.08 GB in 629,578 objects, one gzipped JSON per model call, partitioned by date, provider, model and run. openrouter-traces/: 3.71 GB in 10,400 objects. datasets/: 0.71 GB in 68 objects. work/: 0.35 GB in 1,982 objects. Dates run from 2026-10-24 to 2026-11-10, 18 days. 162.91 GB of 9router/calls/ is gpt-6.1-sol through Codex; all other models total under 5 GB."
assumption = "The bucket is still growing, so each build records its own listing snapshot (clause 2.3). The source data is coding-heavy and dominated by one model."

[observation.bucket_call_objects]
revision = "none (no commits at authoring time)"
command = "Computed the median object size from the listing and expanded one sampled call object in memory."
observed = "Median call object is 226 KB compressed. One sampled object expanded 3.6 times to 820 KB, with 82,176 prompt tokens over 57 history items. Every call carries the full session history. Run, agent and task identifiers are null in every object; only session identifiers exist. Raw call objects contain client headers including IP addresses and installation identifiers."
assumption = "A session collapses to its segments, each kept as its last call (clause 2.2). One sampled object is not a distribution. Client headers are dropped entirely before any record is persisted (clause 3.2)."

[observation.datasets_v2_readme]
revision = "none (no commits at authoring time)"
command = "Read the README of the existing datasets/v2 in the bucket. Its claims were not independently verified."
observed = "The README states: built for a decisions model, not for this feature; trajectories in files of 400 redacted session segments, 19 files, so at most about 7,600 segments; splits by sha1(session_id) mod 100 with 90 train, 5 validation and 5 test; context labels are a lexical heuristic that reproduced at 76% agreement between versions; redaction is pattern-based and should be reviewed before sharing; the provider's terms restrict using its outputs to develop competing models."
assumption = "Reported by the README only. The lexical labels are weak labels (decision d_3), the records are redacted again on ingestion, and the licence position is the operator's (decision d_10)."

[observation.teacher_direct_route]
revision = "none (no commits at authoring time)"
command = "Sent one one-line prompt to gpt-6.1-sol through the direct provider API."
observed = "HTTP 200 in 2.71 s; 13 prompt tokens. The direct API takes the model name with reasoning effort as a separate parameter."
assumption = "The direct route adds no prompt and is the teacher route (decision d_4). One call says nothing about rate limits, cost at scale or latency distribution."

[observation.teacher_gateway_route]
revision = "none (no commits at authoring time)"
command = "Sent the same one-line prompt through gateway 1 using the gateway spelling of the model with high reasoning effort."
observed = "HTTP 200 in 1.84 s; 2,496 prompt tokens for the same prompt. The model variable in the environment file holds the gateway spelling."
assumption = "The gateway route injects about 2,490 tokens into every call and is not used for labels."

[observation.gateway_model_lists]
revision = "none (no commits at authoring time)"
command = "Requested the model lists of gateways 2 and 3."
observed = "HTTP 200 from both; 839 and 838 models."
assumption = "Reachability only. No task depends on these gateways."

[observation.untested_routes]
revision = "none (no commits at authoring time)"
command = "None. Recorded as an explicit gap."
observed = "Cluster keys 4 and 5 and the Messages endpoints were not exercised."
assumption = "Their status is unknown. No task may assume they work."

[observation.gpu_host]
revision = "none (no commits at authoring time)"
command = "Connected to the GPU host over SSH, authenticating with the secret held in the ignored credential file and queried GPU, CPU, memory, disk, operating system, installed software and outbound reachability."
observed = "1 x NVIDIA B200 with 183,359 MiB, driver 580.178.04, idle. 224 CPUs, 59 GB RAM, 446 GB free on an overlay root. Ubuntu 24.04.1 LTS, x86_64, running in a container. Python 3.12.3 only; no git, uv, docker, conda or s5cmd. Present: rsync, curl, wget, pip3, nohup, systemctl and passwordless sudo. Absent: tmux and screen. The package index, the model hub and the uv installer site returned HTTP 200; the teacher API host was reachable (HTTP 401 without a key)."
assumption = "Host RAM is under one third of GPU memory, so data loading streams and stays bounded (decision d_7). The bootstrap of task 6.1 must provision a bare host, and a detached launch cannot depend on tmux or screen. Whether the overlay root survives a host restart was not measured."

[observation.operator_decisions]
revision = "none (no commits at authoring time)"
command = "None. Decisions stated by the operator before authoring."
observed = "Target is general memory with the bucket as a coding-agent slice. Teacher is gpt-6.1-sol through the direct API key. Work runs in fleet mode with a supervising main agent that does not implement tasks. The system is built and smoke-tested on the CPU host, then given a test run on the B200."
assumption = "Recorded as fixed constraints in decisions.md."
