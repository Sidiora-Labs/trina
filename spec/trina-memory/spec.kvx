# Trina: a training system for a memory-retrieval and context-assembly neural network.
# Normative requirements, acceptance clauses, implementation tasks and UNRUN qualification cases.

[meta]
feature = "trina-memory"
name = "Trina memory retrieval and context assembly training system"
version = "0.1.0"
status = "pending"
stage = "specification"
review_date = "2026-11-10"
source_baseline = "none (no commits at authoring time)"
intro = "A training system that produces three learned stages and the pipeline that serves them: a retriever that proposes candidate memories, a set-wise selector that chooses the memories that jointly answer a query, and an assembler that orders and fits them into a token budget. Training data combines redacted coding-agent trajectories from the source bucket with generated general-memory histories and public retrieval sets; a teacher model supplies utility labels. The system is built and smoke-tested on a CPU host and given a test run on one NVIDIA B200."

[decisions]
d_1 = "The target is general memory. A memory item is typed text with metadata; no stage may require a domain-specific field. The source bucket supplies the coding-agent domain only, so generated general-memory data and public sets are required, and results are reported per domain."
d_2 = "The system has three learned stages with separate training and evaluation: retriever, set-wise selector, assembler. A non-learned baseline (BM25, untuned dense, hybrid fusion, an untuned reranker, top-k truncation) exists first and is reported beside every learned result."
d_3 = "Supervision is utility for the reader, not lexical overlap: a teacher model answers with and without candidate memories, and minimal sufficient sets are mined by leave-one-out pruning. The existing lexical context labels in the bucket are a pre-filter only."
d_4 = "The teacher is gpt-6.1-sol through the direct provider API, because the gateway route injects about 2,490 prompt tokens per call. Teacher identity, reasoning effort and prompt version are configuration and are recorded on every label."
d_5 = "Raw bucket objects are read by streaming and never stored in the repository or on persistent local disk. Only redacted, derived records are persisted. The bucket source prefixes are read-only to this system."
d_6 = "Public memory benchmarks are evaluation-only. Training loaders refuse them. Their published flaws (answer-key errors, lenient judges, corpora that fit a context window) are handled by validating the judge and by reporting a held-out generated set and a held-out bucket slice beside them."
d_7 = "One code path runs on CPU and GPU. The CPU host proves the whole pipeline with tiny models and data slices; the B200 performs the real training run. The GPU host has 59 GB of RAM against 183 GB of GPU memory, so data loading streams and is bounded."
d_8 = "Base model choices for the retriever and selector, numerical quality thresholds and the domain mix are proposed in decisions.md and fixed by measurement in task 2.5 and reviewed in task 6.4. Tolerances and thresholds named in clauses are declared in configuration by the task that first needs them and listed in decisions.md. Their presence in a document is not a result."
d_9 = "Work runs as a Hyperfide fleet. The main agent owns this task list, supervises and merges, and does not implement tasks. A task is done only when its verify_cmd passes; a skipped external dependency is reported as SKIPPED and never as PASS."
d_10 = "Using a provider model as teacher and provider-derived trajectories as training data is an operator decision. The licence position is recorded in data.md and repeated in the model card; the system does not judge it."

[req.1]
title = "Domain-agnostic memory, query and context contract"
story = "As an integrator, I need one versioned contract for memories, queries and assembled context so that every stage, dataset and domain uses the same shapes."
ac_1 = "A memory item SHALL have a versioned schema with identity, scope, kind, text, creation time, source and free metadata, and no stage SHALL require a field that exists for only one domain."
ac_2 = "A query SHALL carry text, scope, reference time, token budget and optional time and kind filters, and an assembled context SHALL carry its ordered items, its token count, an abstention flag, a degraded flag naming any stage that fell back, and per-item provenance naming the source item, each stage score and any truncation with its source span."
ac_3 = "Serialization SHALL be canonical and versioned: identical content yields an identical identity across runs and hosts, and an unknown version or malformed record is rejected with a typed error."
ac_4 = "Token counts SHALL come from one declared tokenizer interface, and every budget computation in training, evaluation and serving SHALL use it."

[req.2]
title = "Streaming ingestion of bucket trajectories"
story = "As a data engineer, I need the bucket's call logs turned into deduplicated session episodes without copying raw data out of the bucket."
ac_1 = "Ingestion SHALL read objects through the S3 API by streaming, SHALL NOT write or delete under the bucket's source prefixes, and SHALL NOT persist a raw object to the repository or to persistent local storage."
ac_2 = "Ingestion SHALL collapse each session to its segments (a segment is a maximal run of calls in which each call's history extends the previous one), remove exact retries and cross-source duplicates, and record every skipped object with a reason and a count."
ac_3 = "Each build SHALL record a listing snapshot with object count, byte total, latest object, a digest of the listing and pipeline code hash, and a rebuild over the same snapshot SHALL produce identical record identities."
ac_4 = "Ingestion SHALL be resumable with bounded memory per worker, SHALL report progress, and SHALL record a failed object instead of dropping it silently."
ac_5 = "Episode extraction SHALL turn each segment into ordered memory items (user message, assistant message, tool call, tool output, file content) and decision points usable as queries, preserving order and time."

[req.3]
title = "Credential and data security"
story = "As the operator, I need credentials and sensitive trace content kept out of the repository, logs, datasets and third-party calls."
ac_1 = "Credentials SHALL be read only from the environment or the ignored credential files, and SHALL NOT appear in tracked files, logs, run records, configs, datasets or error messages; a scan gate SHALL fail when a credential pattern is found in tracked files or produced artifacts."
ac_2 = "Before any record is persisted, redaction SHALL replace secret patterns and SHALL drop client headers, IP addresses and installation identifiers, and SHALL record redaction counts by kind."
ac_3 = "A residual-secret audit SHALL run over a sample of every persisted dataset and SHALL fail the build on any high-confidence match."
ac_4 = "Content sent to an external model SHALL be redacted content only, the destination hosts SHALL be an allow-list in configuration, and a call to any other host SHALL be refused."
ac_5 = "Credential files SHALL be mode 600 and ignored by git and by Hyperfide, and a gate SHALL fail when either condition does not hold."

[req.4]
title = "General-memory data generation and public sets"
story = "As a model developer, I need memory data beyond coding transcripts, with known evidence, so that the model is general and its labels can be checked."
ac_1 = "The generator SHALL produce multi-session histories with questions whose gold evidence items are known, covering single fact, multi-session reasoning, temporal reasoning, knowledge update, preference and unanswerable categories."
ac_2 = "Generation SHALL record its sampling seeds for persona, topic and style, SHALL filter near-duplicates, and SHALL report the distribution by category and length."
ac_3 = "Evidence and filler sessions SHALL come from the same generation process, and a surface-feature discriminator between them SHALL score an AUC of at most 0.60 on held-out data."
ac_4 = "Public dataset adapters SHALL convert to the contract with licence and provenance recorded, and sets marked evaluation-only SHALL be refused by every training loader."
ac_5 = "Each answerable generated question SHALL be validated by the teacher answering correctly from the gold evidence alone and failing on the history with that evidence removed; each unanswerable question SHALL be validated by the teacher abstaining on the full history; items that fail SHALL be dropped and counted."

[req.5]
title = "Dataset assembly, splits and leakage control"
story = "As an evaluator, I need immutable dataset versions whose splits cannot leak so that reported numbers mean what they say."
ac_1 = "Splits SHALL be assigned by group (session, persona or source document) so that no group spans two splits, and bucket sessions SHALL keep the existing rule of sha1(session_id) mod 100 with 90 train, 5 validation and 5 test."
ac_2 = "Assembly SHALL check for exact and near-duplicate queries and whole episodes across splits and against every evaluation-only set, and SHALL fail the build on a violation."
ac_3 = "Each dataset version SHALL have an immutable identity and a manifest with counts by domain, category and split, source hashes, code revision and configuration."
ac_4 = "Every example SHALL carry a domain tag, and the domain mix and per-domain sampling weights SHALL be declared in training configuration, outside the dataset version identity."

[req.6]
title = "Teacher access and utility labels"
story = "As a model developer, I need affordable, auditable labels that say which memories the reader actually needed."
ac_1 = "The teacher client SHALL call the configured provider endpoint with no injected prompt, take model and reasoning effort from configuration, cache responses by canonical request digest, and apply rate limits and bounded retries."
ac_2 = "Every call SHALL record tokens and cost, a campaign SHALL print a cost estimate before it starts, and a hard budget cap SHALL stop the campaign before the cap is exceeded by reserving each request's worst-case cost against a bounded output length, with prices taken from a price table in configuration."
ac_3 = "For each query and candidate set, labelling SHALL record whether the set is sufficient for a correct answer, each item's necessity by leave-one-out, a graded utility score per item derived from these outcomes, and a minimal sufficient set found by pruning, with teacher identity, prompt version and judge outcome. For a query with no gold answer the reference SHALL be the recorded next action, and a query whose reference the teacher cannot reproduce from the full history SHALL be excluded and counted."
ac_4 = "Labelling SHALL be resumable and idempotent, and an interrupted campaign SHALL leave a valid, usable partial label set."
ac_5 = "A label audit SHALL measure teacher labels against known gold evidence on generated data and against repeated labelling of the same sample, and SHALL report precision, recall and self-agreement."
ac_6 = "Hard negatives SHALL be mined from baseline retrieval as similar items that are not evidence, and items the labels mark as evidence SHALL be excluded from the negatives."

[req.7]
title = "Memory store and candidate generation"
story = "As a pipeline author, I need a store that returns candidates from the right scope quickly, with a baseline that needs no training."
ac_1 = "The store SHALL add, supersede and delete items under a stable logical key and persist them, and a query SHALL never return an item outside its scope."
ac_2 = "Candidate generation SHALL provide BM25, dense and fused hybrid retrieval with a pluggable encoder."
ac_3 = "Index builds SHALL be incremental, results SHALL be deterministic for a fixed index and query, and the recall of approximate search against exact search SHALL be reported."
ac_4 = "Queries SHALL support filters on time and kind, and recency SHALL be available as a feature to later stages."

[req.8]
title = "Trained retriever"
story = "As a model developer, I need a retriever that finds the needed memories more reliably than the untuned baseline."
ac_1 = "The retriever SHALL be a bi-encoder initialised from a configurable pretrained encoder and trained with in-batch negatives, mined hard negatives and teacher-score distillation."
ac_2 = "Every retriever result SHALL be reported against BM25 and the untuned same encoder on held-out Recall@K per domain at a declared K and by a declared confidence-interval rule, and a model that does not beat them in a domain SHALL be reported as failing for that domain."
ac_3 = "Exported embeddings SHALL carry the model version, and the store SHALL refuse an index built with a different encoder version."
ac_4 = "Items longer than the encoder limit SHALL be handled by a declared chunking or truncation policy that is recorded in the run."

[req.9]
title = "Set-wise selector"
story = "As a model developer, I need a selector that picks the memories that answer the query together, including picking none."
ac_1 = "The selector SHALL score candidates jointly so that each candidate's score can depend on the others, and SHALL output an inclusion probability per item and a no-evidence score."
ac_2 = "The selector SHALL be trained on sufficient-set labels with a set-level objective, and a pointwise reranker trained on the same data SHALL be reported beside it."
ac_3 = "The selector SHALL accept a variable candidate count up to a configured maximum, and its selection SHALL be invariant to candidate input order within a declared tolerance."
ac_4 = "On unanswerable queries the selector SHALL be able to return an empty set, and abstention precision and recall SHALL be measured."

[req.10]
title = "Budgeted context assembler"
story = "As an integrator, I need the selected memories ordered and fitted to a token budget without losing where they came from."
ac_1 = "For any candidates and budget, the assembled context SHALL NOT exceed the token budget under the declared tokenizer."
ac_2 = "Selection under budget SHALL weigh learned utility against token cost and redundancy, and SHALL be reported against greedy top-k truncation."
ac_3 = "The ordering policy SHALL be declared and evaluated, provenance SHALL be preserved, and any truncation or compression of an item SHALL be marked and mapped to its source span."
ac_4 = "Quality SHALL be reported across a declared sweep of token budgets."

[req.11]
title = "Reproducible training system"
story = "As a model developer, I need every run to be configured, recorded, resumable and runnable on both hosts."
ac_1 = "Every run SHALL start from one resolved configuration and SHALL write a run record with configuration, code revision, dataset version, seeds, hardware, metrics and checkpoints."
ac_2 = "Checkpoints SHALL be written atomically, and a resumed run SHALL reproduce the metrics of an uninterrupted run within a declared tolerance."
ac_3 = "The same code path SHALL run on CPU and GPU, and a CPU smoke configuration SHALL complete every stage with tiny models within 30 minutes on the build host."
ac_4 = "Training SHALL support mixed precision and gradient accumulation, SHALL stream its data, and SHALL keep peak host memory under a configured limit that is measured."
ac_5 = "Fixed seeds SHALL give the same metrics within a declared tolerance on the same hardware, and remaining sources of nondeterminism SHALL be documented."
ac_6 = "Metrics SHALL be logged locally in an open line-oriented format, and no external service SHALL be required to train or evaluate."

[req.12]
title = "Evaluation"
story = "As the operator, I need results I can trust: per domain, with baselines, validated judges and no leakage."
ac_1 = "Evaluation SHALL compute Recall@K, nDCG@K and MRR for retrieval and evidence precision, recall, F1 and exact sufficient-set match for selection, each with a bootstrap confidence interval."
ac_2 = "End-to-end evaluation SHALL have a reader answer from the assembled context at a fixed budget and a judge score the answer, and the judge SHALL be validated on a labelled sample that includes intentionally wrong answers, with its false-accept rate reported; reader and judge identity SHALL be configured and recorded."
ac_3 = "Every report SHALL include BM25, untuned dense, hybrid, an untuned off-the-shelf reranker, top-k truncation, full context where it fits, and oracle evidence."
ac_4 = "Results SHALL be reported per domain and per category, and an aggregate SHALL never be reported alone."
ac_5 = "Evaluation-only sets SHALL be absent from training data, enforced by the loaders and verified against the dataset manifest."
ac_6 = "Evaluation SHALL report latency at the median and 95th percentile per stage, assembled tokens and throughput on the declared hardware."
ac_7 = "Ablations SHALL remove each learned stage in turn and report its contribution."

[req.13]
title = "Inference pipeline and serving"
story = "As an integrator, I need one call that turns a query into assembled context, and the same code used in evaluation."
ac_1 = "One pipeline interface SHALL take a query and return assembled context, and evaluation SHALL use that same interface."
ac_2 = "The pipeline SHALL be available as a command-line tool and a local HTTP interface whose versioned request and response are the contract of requirement 1."
ac_3 = "The pipeline SHALL load a versioned model bundle of retriever, selector, assembler, tokenizer and configuration, and SHALL refuse an inconsistent bundle."
ac_4 = "When a learned stage is unavailable the pipeline SHALL fall back to the declared baseline for that stage and SHALL mark the response as degraded."

[req.14]
title = "Remote GPU execution"
story = "As the operator, I need the training run launched on a bare GPU host and its results brought back, without leaking credentials."
ac_1 = "A bootstrap SHALL provision a bare host idempotently from the pinned lockfile and SHALL record host facts: GPU, driver, memory and disk."
ac_2 = "Code and datasets SHALL be synchronised by content hash, a remote run SHALL be detached and survive a dropped connection, and its logs, metrics and checkpoints SHALL be retrievable."
ac_3 = "Host credentials SHALL come from the ignored credential file and SHALL NOT appear on a command line or in a log, and credentials placed on the host SHALL be in a mode-600 file that teardown removes."
ac_4 = "A preflight SHALL check GPU visibility, free GPU memory, disk space and dataset checksums, and SHALL refuse to launch when a check fails."
ac_5 = "A declared test-run configuration SHALL train all three stages on the B200, evaluate them and return a report whose run record includes GPU utilisation and peak GPU memory."

[req.15]
title = "Workflow, evidence and documentation"
story = "As the operator, I need task completion to mean executed evidence, and the finished system to be documented with its limits."
ac_1 = "Each task's verify_cmd SHALL execute real code paths, a test that could not reach an external dependency SHALL report SKIPPED and SHALL NOT count as a pass, and a task whose acceptance needs that dependency SHALL fail its verify_cmd when the dependency is unmet."
ac_2 = "Evidence SHALL be recorded in qualification.kvx with revision, command, exit code, log and observation."
ac_3 = "A specification validator SHALL parse the specification, check references, dependency order and clause coverage, and detect stale derived views."
ac_4 = "Documentation SHALL include a README, usage guide, data card and model card that state the single-teacher bias, the coding-heavy source data and the licence position."
ac_5 = "Release closure SHALL require an end-to-end report from the B200 run and operator acceptance of the running system."

[design]
overview = "Trina is a Python package with a streaming data plane, a teacher-labelling plane, three trainable stages and one inference pipeline shared by evaluation and serving. design.body.md describes the boundaries and one query from memory store to assembled context; the contract documents refine each requirement."

[documentation]
mode      = "manual"
status    = "pending"
audiences = ["user", "developer"]
targets   = ["README.md", "docs/**"]

[tasks]
heading = "Implementation Plan: trina-memory"

# Wave 0: foundation.

[task.0.1]
title = "Project scaffold, toolchain, gates and credential hygiene check"
status = "pending"
wave = 0
touches = ["pyproject.toml", "uv.lock", ".python-version", "Makefile", ".gitignore", ".hyperfideignore", "src/trina/__init__.py", "src/trina/cli.py", "tests/conftest.py", "tests/cases/test_0_1.py", "scripts/check_hygiene.py", "scripts/record_evidence.py"]
verify_cmd = "uv run pytest tests/cases/test_0_1.py -q"
do_1 = "Install uv for the build host, create the trina package under src/ with Python 3.12, pin dependencies in uv.lock, and provide make test and make lint as the fleet gates (pytest, ruff, mypy). Add data/ and runs/ to .gitignore and .hyperfideignore."
do_2 = "Add a pytest marker scheme for external dependencies (network, bucket, teacher, gpu) whose unmet condition reports SKIPPED with a reason; make test prints the skipped count and never folds it into the pass count. Add a --require option naming dependencies that must be met: with it, an unmet named dependency is a failure, so a verify_cmd that needs a live dependency cannot pass on skips."
do_3 = "Write scripts/check_hygiene.py and wire it into make lint: fail when a credential file is not mode 600, is not ignored by git or by Hyperfide, or when a credential pattern appears in a tracked file. Write scripts/record_evidence.py, which appends an evidence entry (revision, command, exit code, log, observation) to qualification.kvx; the main supervisor runs it when a wave lands."
do_4 = "test_0_1.py runs the gates on the real tree, proves the hygiene check fails on a planted fixture and passes on the repository, and runs the specification validator with its stale-view check."
reqs = ["3.1", "3.5", "15.1", "15.2", "15.3"]
owner = "foundation"
cases = ["TRM-003", "TRM-026"]

[task.0.2]
title = "Memory, query and assembled-context contract"
status = "pending"
wave = 0
requires = ["0.1"]
touches = ["src/trina/schema/**", "tests/cases/test_0_2.py", "tests/fixtures/schema/**"]
verify_cmd = "uv run pytest tests/cases/test_0_2.py -q"
do_1 = "Define versioned MemoryItem, Query, Candidate, AssembledContext and Provenance types with canonical serialization and content-derived identities; reject unknown versions and malformed records with typed errors."
do_2 = "Define the tokenizer interface and one default implementation; expose a single count function that every budget computation must call."
do_3 = "test_0_2.py covers round trips with golden vectors, identity stability, rejection cases, and a property test that no required field is domain-specific by building items from a coding episode and a conversational session through the same constructor."
reqs = ["1.1", "1.2", "1.3", "1.4"]
owner = "foundation"
cases = ["TRM-001"]

[task.0.3]
title = "Configuration resolution and run records"
status = "pending"
wave = 0
requires = ["0.1"]
touches = ["src/trina/config/**", "src/trina/runs/**", "configs/base/**", "tests/cases/test_0_3.py"]
verify_cmd = "uv run pytest tests/cases/test_0_3.py -q"
do_1 = "Implement layered configuration that resolves to one frozen document with a digest; unknown keys are errors."
do_2 = "Implement the run record: resolved configuration, code revision, dataset version, seeds, hardware facts, metrics as JSONL and checkpoint index, written under an ignored runs/ directory with no external service."
do_3 = "test_0_3.py resolves layered fixtures, proves digest stability and unknown-key rejection, and writes and reloads a run record from a real toy run."
reqs = ["11.1", "11.6"]
owner = "foundation"
cases = ["TRM-002"]

[task.0.4]
title = "Secret loading, redaction and residual-secret audit"
status = "pending"
wave = 0
requires = ["0.1"]
touches = ["src/trina/security/**", "Makefile", "tests/cases/test_0_4.py", "tests/fixtures/security/**"]
verify_cmd = "uv run pytest tests/cases/test_0_4.py -q"
do_1 = "Implement a secrets loader that reads the environment and the ignored credential files, returns opaque values that redact themselves in repr, str and logging, and never writes them. Credential files are ignored and so are absent from task worktrees: locate them through TRINA_SECRETS_DIR, defaulting to the main repository root resolved from git's common directory."
do_2 = "Implement redaction for API keys, cloud and repository tokens, bearer tokens, private keys and password and token assignments, and dropping of IP addresses and installation identifiers, with counts by kind; client headers are dropped entirely."
do_3 = "Implement the residual-secret audit over a sample of records and an artifact scanner exposed as a command; wire it into make lint for produced artifacts, and make it callable by every dataset build."
do_4 = "test_0_4.py uses synthetic secrets only: every pattern is redacted, counts are right, the audit catches a planted secret, and a secret passed through logging and an exception message does not appear in captured output."
reqs = ["3.1", "3.2", "3.3", "3.5"]
owner = "foundation"
cases = ["TRM-003", "TRM-004"]

# Wave 1: sources and teacher access.

[task.1.1]
title = "Streaming bucket ingestion with snapshot, dedupe and resume"
status = "pending"
wave = 1
requires = ["0.2", "0.3", "0.4"]
touches = ["src/trina/data/bucket/**", "configs/data/bucket.toml", "tests/cases/test_1_1.py", "tests/fixtures/bucket/**"]
verify_cmd = "uv run pytest tests/cases/test_1_1.py -q --require bucket"
do_1 = "Implement a read-only S3 client wrapper that exposes list and streamed get only, so writes and deletes under source prefixes are impossible through it; read datasets/v2 trajectories first and raw call objects second."
do_2 = "Implement snapshot listing, parallel streamed extraction with bounded memory per worker, session collapse to segments, retry and cross-source dedupe, skip reasons with counts, a failed-object ledger and resumable shards. Redact before any record is written, and run the residual-secret audit on the written shards."
do_3 = "Record the listing snapshot manifest and prove a rebuild over the same snapshot yields identical record identities."
do_4 = "test_1_1.py runs the real pipeline against synthetic fixture objects served by a local S3-compatible endpoint, including an interrupted run that resumes, and runs a small live-bucket slice marked bucket. Take split assignments from the existing v2 session index and verify the residue mapping against it instead of assuming which residues are train, validation and test."
reqs = ["2.1", "2.2", "2.3", "2.4", "3.2", "3.3"]
owner = "data"
cases = ["TRM-004", "TRM-005"]

[task.1.2]
title = "Episode extraction from agent trajectories"
status = "pending"
wave = 1
requires = ["1.1"]
touches = ["src/trina/data/episodes/**", "tests/cases/test_1_2.py", "tests/fixtures/episodes/**"]
verify_cmd = "uv run pytest tests/cases/test_1_2.py -q"
do_1 = "Convert each segment into ordered memory items by kind with times, and into decision points: at each model step, the query is the step's situation and the memory is every earlier item in the session."
do_2 = "Carry the bucket's lexical reference labels as weak labels marked as such, and derive natural signals where present: an item re-read later, and items referenced after a compaction."
do_3 = "test_1_2.py checks order, kinds, times and counts on fixtures built from the documented trajectory format, and that weak labels are never exposed under the name of gold labels."
reqs = ["2.5"]
owner = "data"
cases = ["TRM-006"]

[task.1.3]
title = "Teacher client with cache, budget cap and host allow-list"
status = "pending"
wave = 1
requires = ["0.2", "0.3", "0.4"]
touches = ["src/trina/teacher/client/**", "configs/teacher/**", "tests/cases/test_1_3.py"]
verify_cmd = "uv run pytest tests/cases/test_1_3.py -q --require teacher"
do_1 = "Implement the teacher client against the direct provider endpoint with model and reasoning effort from configuration, a response cache keyed by canonical request digest, rate limiting, bounded retries and concurrency."
do_2 = "Implement spend accounting per call, a dry-run cost estimate, and a hard budget cap that reserves each request's worst-case cost from a configured price table and a bounded output length, so it stops before the cap is exceeded. Refuse any destination host not on the configured allow-list, and refuse content that fails the redaction check."
do_3 = "test_1_3.py runs the real client against a local fake provider for cache hits, retry, rate limit, cap enforcement and host refusal, and one live call marked teacher that records prompt tokens."
reqs = ["3.4", "6.1", "6.2"]
owner = "teacher"
cases = ["TRM-007"]

[task.1.4]
title = "Public dataset and benchmark adapters"
status = "pending"
wave = 1
requires = ["0.2", "0.3"]
touches = ["src/trina/data/public/**", "configs/data/public.toml", "tests/cases/test_1_4.py", "tests/fixtures/public/**"]
verify_cmd = "uv run pytest tests/cases/test_1_4.py -q --require network"
do_1 = "Implement adapters that convert public retrieval sets and memory benchmarks to the contract, recording licence, provenance and download checksum in a registry."
do_2 = "Mark memory benchmarks evaluation-only in the registry and make the shared training-loader entry point refuse any set so marked."
do_3 = "test_1_4.py converts fixture samples of each format, checks the registry fields, proves the training loader refuses an evaluation-only set, and runs real downloads marked network."
reqs = ["4.4", "12.5"]
owner = "data"
cases = ["TRM-008"]

# Wave 2: general-memory data, baseline retrieval and evaluation.

[task.2.1]
title = "General-memory history generator"
status = "pending"
wave = 2
requires = ["1.3"]
touches = ["src/trina/data/synth/**", "configs/data/synth.toml", "tests/cases/test_2_1.py", "tests/fixtures/synth/**"]
verify_cmd = "uv run pytest tests/cases/test_2_1.py -q --require teacher"
do_1 = "Generate multi-session histories from sampled personas, topics and styles with recorded seeds, planting evidence and writing questions for the six categories with gold evidence item identities."
do_2 = "Generate evidence and filler sessions through the same process, filter near-duplicates, and report distribution by category and length."
do_3 = "Validate each answerable question with the teacher (correct from gold evidence alone, wrong on the history with that evidence removed) and each unanswerable question by the teacher abstaining on the full history; drop and count failures. Train the surface-feature discriminator and fail when its held-out AUC exceeds 0.60."
do_4 = "test_2_1.py runs the generator end to end on a fake teacher with deterministic output, and a small live generation marked teacher with a spend cap."
reqs = ["4.1", "4.2", "4.3", "4.5"]
owner = "data"
cases = ["TRM-009"]

[task.2.2]
title = "Memory store with BM25, dense and hybrid candidate generation"
status = "pending"
wave = 2
requires = ["0.2", "0.3"]
touches = ["src/trina/store/**", "configs/store/**", "tests/cases/test_2_2.py"]
verify_cmd = "uv run pytest tests/cases/test_2_2.py -q"
do_1 = "Implement the persisted store with add, supersede and delete under a stable logical key, scope isolation, and time and kind filters; expose recency as a candidate feature."
do_2 = "Implement BM25, dense retrieval with a pluggable encoder, and reciprocal-rank fusion; build indexes incrementally, record the encoder version in the index, and refuse a query whose encoder version differs from the index."
do_3 = "test_2_2.py proves scope isolation with adversarially similar items in another scope, determinism for a fixed index, incremental build equivalence to a full build under exact search, filter behaviour, and reports approximate against exact recall."
reqs = ["7.1", "7.2", "7.3", "7.4", "8.3"]
