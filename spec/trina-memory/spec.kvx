# Qualification cases. All are UNRUN until executed evidence is recorded.

[case.TRM-001]
title = "Contract round trip, identity stability and rejection"
status = "UNRUN"
tier = "component"
reqs = ["1.1", "1.2", "1.3", "1.4"]
tasks = ["0.2"]
oracle = "Golden vectors reproduce byte for byte; malformed and unknown-version records raise typed errors; one constructor serves two domains."

[case.TRM-002]
title = "Configuration resolution and run record completeness"
status = "UNRUN"
tier = "component"
reqs = ["11.1", "11.6"]
tasks = ["0.3"]
oracle = "A run record reloads to the exact resolved configuration, revision, seeds and metrics with no network access."

[case.TRM-003]
title = "Credential hygiene"
status = "UNRUN"
tier = "component"
reqs = ["3.1", "3.5"]
tasks = ["0.1", "0.4"]
oracle = "A planted credential or a loosened file mode fails the gate; no credential value appears in captured logs, errors or artifacts."

[case.TRM-004]
title = "Redaction and residual-secret audit"
status = "UNRUN"
tier = "component"
reqs = ["3.2", "3.3"]
tasks = ["0.4", "1.1", "2.4"]
oracle = "Every synthetic secret kind is redacted with correct counts, and the audit fails on a planted survivor."

[case.TRM-005]
title = "Bucket ingestion determinism, read-only access and resume"
status = "UNRUN"
tier = "integration"
reqs = ["2.1", "2.2", "2.3", "2.4"]
tasks = ["1.1"]
oracle = "Two builds over one snapshot give identical identities; an interrupted build resumes to the same result; no write reaches the source prefixes and no raw object is left on disk."

[case.TRM-006]
title = "Episode extraction fidelity"
status = "UNRUN"
tier = "component"
reqs = ["2.5"]
tasks = ["1.2"]
oracle = "Items, kinds, order and times match the fixture trajectories, and weak labels are distinguishable from gold labels."

[case.TRM-007]
title = "Teacher client cache, budget cap and host refusal"
status = "UNRUN"
tier = "integration"
reqs = ["3.4", "6.1", "6.2"]
tasks = ["1.3"]
oracle = "A repeated request costs nothing, the cap stops the campaign before it is exceeded, and a call to an unlisted host or with unredacted content is refused."

[case.TRM-008]
title = "Evaluation-only sets cannot reach training"
status = "UNRUN"
tier = "component"
reqs = ["4.4", "12.5"]
tasks = ["1.4", "2.4"]
oracle = "A training loader given an evaluation-only set raises, and the dataset manifest contains none of its items."

[case.TRM-009]
title = "Generated history validity and indistinguishable evidence"
status = "UNRUN"
tier = "integration"
reqs = ["4.1", "4.2", "4.3", "4.5"]
tasks = ["2.1"]
oracle = "All six categories are present with gold evidence, invalid questions are dropped and counted, and the discriminator AUC is at most 0.60."

[case.TRM-010]
title = "Group splits, leakage refusal and manifest"
status = "UNRUN"
tier = "integration"
reqs = ["5.1", "5.2", "5.3", "5.4"]
tasks = ["2.4"]
oracle = "A planted cross-split group, near-duplicate or benchmark item fails the build; a clean build has a stable version identity and a complete manifest."

[case.TRM-011]
title = "Store scope isolation and baseline retrieval"
status = "UNRUN"
tier = "component"
reqs = ["7.1", "7.2", "7.3", "7.4"]
tasks = ["2.2"]
oracle = "No query returns an item from another scope; incremental and full index builds agree under exact search; results are deterministic."

[case.TRM-012]
title = "Metric correctness"
status = "UNRUN"
tier = "component"
reqs = ["12.1"]
tasks = ["2.3"]
oracle = "Every metric matches hand-computed values and an independent reference, including edge cases."

[case.TRM-013]
